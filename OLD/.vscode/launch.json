    "version": "0.2.0",
    "configurations": [
        {
            "name": "PowerShell: Launch Current File",
            "type": "PowerShell",
            "request": "launch",
            "script": "${file}",
            "args": []
        },
        {
            "name": "Python: Launch Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Cosmology CLI (Interactive)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/cosmology_cli.py",
            "args": [
                "interactive"
            ],
            "console": "integratedTerminal"
        }
    ]
}